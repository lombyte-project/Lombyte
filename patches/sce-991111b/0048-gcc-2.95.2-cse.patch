+/* The 2.9 tree has no fnotice and no do_float_handler (from gcc-2.95.2).  */
+#define fnotice fprintf
+static int
+do_float_handler (fn, data)
+     void (*fn) PROTO ((PTR));
+     PTR data;
+{
+  jmp_buf buf;
+
+  if (setjmp (buf))
+    {
+      set_float_handler (NULL);
+      return 0;
+    }
+  set_float_handler (buf);
+  (*fn) (data);
+  set_float_handler (NULL);
+  return 1;
+}
