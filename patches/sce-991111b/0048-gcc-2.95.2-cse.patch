+/* The 2.9 tree's libiberty has no splay_tree_compare_ints (from gcc-2.95.2).  */
+static int
+splay_tree_compare_ints (k1, k2)
+     splay_tree_key k1;
+     splay_tree_key k2;
+{
+  if ((int) k1 < (int) k2)
+    return -1;
+  else if ((int) k1 > (int) k2)
+    return 1;
+  return 0;
+}
 
