diff --git a/gcc/sibcall.c b/gcc/sibcall.c
index f2dec78..d2d6a70 100644
--- a/gcc/sibcall.c
+++ b/gcc/sibcall.c
@@ -330,6 +330,20 @@ optimize_sibling_and_tail_recursive_calls ()
 
   insns = get_insns ();
 
+  /* gcc-2.95.2 and the retail compiler have no such pass.  Without a
+     CALL_PLACEHOLDER to resolve (sibling calls are off, so only tail
+     recursion makes one) the jump_optimize_minimal and CFG work below
+     would only reshape the RTL before the first jump pass: it deletes the
+     jump to the return label after the last return, which lets jump.c
+     if-convert `return 1; ... return 0;' tails that retail keeps as
+     branches.  */
+  for (insn = insns; insn; insn = NEXT_INSN (insn))
+    if (GET_CODE (insn) == CALL_INSN
+	&& GET_CODE (PATTERN (insn)) == CALL_PLACEHOLDER)
+      break;
+  if (insn == 0)
+    return;
+
   /* We do not perform these calls when flag_exceptions is true, so this
      is probably a NOP at the current time.  However, we may want to support
      sibling and tail recursion optimizations in the future, so let's plan
