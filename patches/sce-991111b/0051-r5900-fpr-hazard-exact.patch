 #ifdef USE_STDARG
+/* Like insn_uses_reg, but without lumping an even/odd floating-point pair
+   together.  That lumping exists because the assembler cannot tell "reads both
+   $f0 and $f1" from "reads one of them", and it is needed for the load/store
+   case it was written for.  It is wrong for a coprocessor move: mtc1 into $f4
+   does not touch $f5, so pairing them makes the delay-slot search invent a
+   hazard nop that the original assembler never emits.  */
+static int
+insn_uses_fpr_exact (ip, reg)
+     struct mips_cl_insn *ip;
+     unsigned int reg;
+{
+  if (ip->insn_mo->pinfo & INSN_READ_FPR_S)
+    if (((ip->insn_opcode >> OP_SH_FS) & OP_MASK_FS) == reg)
+      return 1;
+  if (ip->insn_mo->pinfo & INSN_READ_FPR_T)
+    if (((ip->insn_opcode >> OP_SH_FT) & OP_MASK_FT) == reg)
+      return 1;
+  return 0;
+}
