diff --git a/gcc/configure.in b/gcc/configure.in
index e43c157..9c056d7 100644
--- a/gcc/configure.in
+++ b/gcc/configure.in
@@ -2625,6 +2625,16 @@ changequote([,])dnl
 		tm_file="mips/elf64.h"
 		tmake_file=mips/t-elf
 		;;
+	mips64r5900*-*-elf*)
+		target_cpu_default="MASK_SINGLE_FLOAT | MASK_MIPS5900"
+		tm_file="mips/elf5900.h libgloss.h"
+		tmake_file=mips/t-r5900
+		if test x$host != x$target
+		then
+			target_requires_64bit_host_wide_int=yes
+		fi
+		use_collect2=yes
+		;;
 	mips64orion-*-elf*)
 		tm_file="mips/elforion.h mips/elf64.h libgloss.h"
 		tmake_file=mips/t-elf
