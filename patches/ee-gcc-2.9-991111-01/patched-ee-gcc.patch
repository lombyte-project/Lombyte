      clobber pseudos instead of scratches.  */
-  if (HAVE_mulsi3_mult3_r5900)
+  /* ASTRA P2: retail R5900 code uses the classic mult/mflo sequence (105
+     classic vs 9 rd-form mult sites in .main text), so the R5900 expand must
+     fall through to mulsi3_internal.  */
+  if (HAVE_mulsi3_mult3_r5900 && !TARGET_MIPS5900)
     {
       emit_insn (gen_mulsi3_mult3_r5900 (operands[0], operands[1], operands[2],
 				         gen_reg_rtx (SImode),
@@ -6115,6 +6118,49 @@ move\\t%0,%z4\\n\\
    (set_attr "length"	"1,2,1,2,1,2,1,2,1,1,1,1,2,1,2,1,1,1,1")])
 
 ;; CYGNUS LOCAL law
+;; ASTRA: a volatile store to an absolute address that reorg puts in a call
+;; delay slot is split into lui $1 before the call and sw through $1 in the
+;; slot, the retail form.
+(define_split
+  [(set (match_operand:SI 0 "memory_operand" "")
+        (match_operand:SI 1 "register_operand" ""))]
+  "mips_astra_volatile_split_active && reload_completed && !TARGET_MIPS16
+   && MEM_VOLATILE_P (operands[0])
+   && GET_CODE (XEXP (operands[0], 0)) == CONST_INT
+   && !SMALL_INT (XEXP (operands[0], 0))
+   && REGNO (operands[1]) != 1"
+  [(set (reg:SI 1) (unspec:SI [(match_dup 3)] 40))
+   (set (match_dup 4) (unspec:SI [(match_dup 1)] 41))]
+  "{
+    HOST_WIDE_INT address = INTVAL (XEXP (operands[0], 0));
+    HOST_WIDE_INT low = (address & 0xffff) ^ 0x8000;
+    low -= 0x8000;
+    operands[3] = GEN_INT (address - low);
+    operands[4] = copy_rtx (operands[0]);
+    XEXP (operands[4], 0) = gen_rtx_PLUS (Pmode, gen_rtx_REG (SImode, 1),
+					  GEN_INT (low));
+  }")
+
+;; The two halves of that split.  They use $at, so the pair is bracketed
+;; with .set noat / .set at.
+(define_insn "astra_at_high"
+  [(set (reg:SI 1)
+	(unspec:SI [(match_operand:SI 0 "const_int_operand" "")] 40))]
+  "!TARGET_MIPS16"
+  "%[li\\t$1,%0"
+  [(set_attr "type"	"arith")
+   (set_attr "mode"	"SI")
+   (set_attr "length"	"1")])
+
+(define_insn "astra_at_store"
+  [(set (match_operand:SI 0 "memory_operand" "=m")
+	(unspec:SI [(match_operand:SI 1 "register_operand" "d")] 41))]
+  "!TARGET_MIPS16"
+  "sw\\t%1,%0%]"
+  [(set_attr "type"	"store")
+   (set_attr "mode"	"SI")
+   (set_attr "length"	"1")])
+
 (define_insn "movsi_internal2"
   [(set (match_operand:SI 0 "nonimmediate_operand" "=d,d,d,d,d,d,R,m,*d,*z,*x*w,*d,*x*w,*d")
 	(match_operand:SI 1 "move_operand" "d,S,IKL,Mnis,R,m,dJ,dJ,*z,*d,J,*x*w,*d,*a*q"))]
diff --git a/ee/gcc/reorg.c b/ee/gcc/reorg.c
index f9b2cc2c..5855052f 100644
--- a/ee/gcc/reorg.c
+++ b/ee/gcc/reorg.c
@@ -2004,6 +2004,32 @@ update_reg_unused_notes (insn, redundant_insn)
    or not.  `final' knows how to deal with this, by communicating
    through FINAL_SEQUENCE.  */
 
+/* No instruction is crossed except the call opcode. Its delayed effects
+   occur after the slot; RA and indirect-call/address dependencies still apply. */
+static int
+astra_adjacent_volatile_store_p (trial, call, set, needed)
+     rtx trial, call;
+     struct resources *set, *needed;
+{
+  rtx x;
+  struct resources trial_set, trial_needed;
+  if (GET_CODE (call) != CALL_INSN || prev_nonnote_insn (call) != trial
+      || GET_CODE (trial) != INSN)
+    return 0;
+  x = single_set (trial);
+  if (!x || GET_CODE (SET_DEST (x)) != MEM
+      || !MEM_VOLATILE_P (SET_DEST (x)) || GET_CODE (SET_SRC (x)) != REG)
+    return 0;
+  CLEAR_RESOURCE (&trial_set);
+  CLEAR_RESOURCE (&trial_needed);
+  mark_set_resources (trial, &trial_set, 0, 1);
+  mark_referenced_resources (trial, &trial_needed, 1);
+  trial_set.volatil = trial_needed.volatil = 0;
+  return !resource_conflicts_p (&trial_needed, set)
+    && !resource_conflicts_p (&trial_set, set)
+    && !resource_conflicts_p (&trial_set, needed);
+}
